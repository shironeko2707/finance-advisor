# Environment mode for Lengkeng UI
# Can be: development (debug logs), staging (trace logs), production (error logs)
# VITE_MODE=local

# API Configuration
# Main API base URL, default value below
# VITE_API_BASE_URL=http://hndw-pthoang2:8000

# Auth service base URL, default value below
# VITE_AUTH_BASE_URL=http://hndw-pthoang2:8000

# File base URL for downloads (used for generated report downloads)
# VITE_FILE_BASE_URL=http://hndw-pthoang2:8888

# Authentication Mode
# Set to 'true' to use mock authentication instead of real API
# VITE_USE_MOCK_AUTH=false