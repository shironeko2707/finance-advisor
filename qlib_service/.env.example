# Service Configuration
QLIB_SERVICE_HOST=0.0.0.0
QLIB_SERVICE_PORT=8081
SERVICE_NAME=qlib-advisor-predictor
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://lengkeng_user:lengkeng_password@postgres:5432/lengkeng

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=60

# Queue Names
QUEUE_AI_EXTRACTION_COMPLETE=ai_extraction_complete
QUEUE_QLIB_PREDICTIONS_READY=qlib_predictions_ready
QUEUE_DLQ=qlib_predictions_dlq

# Exchange Names
EXCHANGE_NAME=khengleong.direct
EXCHANGE_TYPE=direct

# Qlib Configuration
QLIB_REGION=cn
QLIB_PROVIDER_URI=/app/qlib_data/cn_data
QLIB_DATA_DIR=/app/qlib_data
QLIB_MODELS_DIR=/app/models_storage

# Qlib Model Settings
QLIB_DEFAULT_MODEL=lightgbm
QLIB_FORECAST_HORIZONS=1,5,30
QLIB_CACHE_MODELS=true
QLIB_FEATURE_SET=alpha158

# Performance Tuning
QLIB_MAX_WORKERS=4
QLIB_BATCH_SIZE=10
QLIB_PREDICTION_TIMEOUT=300
CONSUMER_PREFETCH_COUNT=1

# Feature Flags
ENABLE_FORECASTING=true
ENABLE_PORTFOLIO_ANALYSIS=true
ENABLE_RECOMMENDATIONS=true
ENABLE_BACKTESTING=false

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Security
API_KEY_ENABLED=false
API_KEY=your_secret_api_key_here

# Development Settings
DEBUG=false
RELOAD=false
